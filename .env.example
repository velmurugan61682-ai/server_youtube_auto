# Runtime Configuration
NODE_ENV=development
PORT=5000
SERVER_URL=http://localhost:5000
API_BASE_URL=http://localhost:5000/api

# Frontend and CORS
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
VITE_FRONTEND_URL=http://localhost:5173
EXTRA_ORIGINS=http://localhost:5173,http://localhost:5174,https://channelbot.in

# Database and Auth
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/database?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
ADMIN_JWT_SECRET=your_admin_jwt_secret_here
DEV_SSO_KEY=your_sso_key
EXTERNAL_ADMIN_API_KEY=your_external_api_key

# Admin Account
ADMIN_EMAIL=admin@channelbot.ai
ADMIN_PASSWORD=your_admin_password

# Google & YouTube OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/youtube/callback
YOUTUBE_OAUTH_CLIENT_ID=your_google_client_id
YOUTUBE_OAUTH_CLIENT_SECRET=your_google_client_secret

YOUTUBE_API_KEY=your_youtube_api_key

# Automation Services
